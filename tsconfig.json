{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true
  },
  "include": [
    "lib/shared/task/status.js",
    "lib/host/async-work.js",
    "lib/shared/client/polling.js",
    "lib/shared/locales/*.js",
    "lib/host/resources.js",
    "lib/shared/client/panel-geometry.js"
  ]
}
